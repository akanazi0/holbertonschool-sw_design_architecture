classDiagram

    class Library {
        +add_book()
        +register_user()
        +create_loan()
    }

    class Book {
        +str title
        +str author
        +bool is_available
        +mark_as_unavailable()
        +mark_as_available()
    }

    class User {
        +str name
        +str email
    }

    class Loan {
        +str start_date
        +str end_date
        +close_loan()
    }

    Library o-- "*" Book : manages
    Library o-- "*" User : registers
    Library *-- "*" Loan : manages
    Loan --> "1" Book : borrows
    Loan --> "1" User : made_by
